#!/usr/bin/env bash
# Pre-commit gate: Rust clippy + fmt, frontend Biome.
# Install once per clone: git config core.hooksPath .githooks
set -euo pipefail

# Re-enter via nix develop so cargo/node exist; IN_NIX_SHELL guards recursion.
if [ -z "${IN_NIX_SHELL:-}" ] && command -v nix >/dev/null 2>&1; then
	exec nix develop -c bash "$0" "$@"
fi

cd "$(git rev-parse --show-toplevel)"

fail() {
	echo "pre-commit: $*" >&2
	exit 1
}
command -v cargo >/dev/null 2>&1 || fail "cargo not found (no nix? run inside: nix develop)"
command -v node >/dev/null 2>&1 || fail "node not found"

echo "==> cargo clippy"
cargo clippy --all-targets -- -D warnings

echo "==> cargo fmt --check"
cargo fmt --check

echo "==> biome check"
if [ -x node_modules/.bin/biome ]; then
	node_modules/.bin/biome check --error-on-warnings .
else
	npx --yes @biomejs/biome check --error-on-warnings .
fi

echo "pre-commit: all green"
