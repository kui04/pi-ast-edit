# Copy to scripts/.env and fill in. Every entry is also passed into `pi`'s
# environment, so provider API keys (e.g. OPENAI_API_KEY) belong here too.
# Required: model pi should use, e.g. ollama-cloud/gemma4:31b
PI_E2E_MODEL=
# Optional: pi --thinking level (default: pi's default)
# PI_E2E_THINKING=max
# Optional: per-case timeout in ms (default 600000)
# PI_E2E_TIMEOUT_MS=600000
# Optional: pi binary (default: pi from PATH)
# PI_E2E_PI_BIN=pi
# Optional: keep fixture dirs after the run for debugging (default: 0)
# PI_E2E_KEEP=0
